{
  "entities": {
    "Business": {
      "title": "Business",
      "description": "Information about a registered business or merchant in DigiSolia POS (Caisse Pro)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 120 },
        "tradeType": { "type": "string", "maxLength": 80 },
        "currency": { "type": "string", "maxLength": 10 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 200 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "subscriptionPlan": { "type": "string", "enum": ["starter", "pro", "enterprise"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "trial", "expired", "suspended"] },
        "subscriptionExpiresAt": { "type": "string" },
        "totalSalesCount": { "type": "number" },
        "developerFeeRate": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "tradeType", "currency", "ownerName", "subscriptionPlan", "subscriptionStatus"]
    },
    "User": {
      "title": "User",
      "description": "User profile supporting both DigiSolia App Framework accounts and Caisse Pro staff roles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "firstName": { "type": "string", "maxLength": 60 },
        "lastName": { "type": "string", "maxLength": 60 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "appId": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "enum": ["developer", "owner", "manager", "cashier", "user"] },
        "businessId": { "type": "string" },
        "pinCode": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" },
        "avatar": { "type": "string" }
      },
      "required": ["id", "name", "role", "status"]
    },
    "DigiSoliaApp": {
      "title": "DigiSoliaApp",
      "description": "Registered application inside the DigiSolia App Framework ecosystem",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9\\-]+$" },
        "appId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "shortDescription": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 60 },
        "version": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["active", "maintenance", "beta", "archived"] },
        "usersCount": { "type": "number" },
        "primaryColor": { "type": "string", "maxLength": 20 },
        "secondaryColor": { "type": "string", "maxLength": 20 },
        "supportWhatsapp": { "type": "string", "maxLength": 30 },
        "supportPhone": { "type": "string", "maxLength": 30 },
        "supportEmail": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "appId", "name", "version", "status"]
    },
    "DigiSoliaFeedback": {
      "title": "DigiSoliaFeedback",
      "description": "User rating, comment, suggestion, bug report, or complaint scoped to an application",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "appId": { "type": "string", "maxLength": 64 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "enum": ["comment", "suggestion", "bug", "complaint"] },
        "rating": { "type": "number" },
        "message": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "in_progress", "resolved", "rejected"] },
        "adminResponse": { "type": "string", "maxLength": 1500 },
        "handledBy": { "type": "string", "maxLength": 120 },
        "handledAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "appId", "category", "message", "status", "createdAt"]
    },
    "DigiSoliaSupportTicket": {
      "title": "DigiSoliaSupportTicket",
      "description": "Technical support or helpdesk request scoped to an application",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "appId": { "type": "string", "maxLength": 64 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 120 },
        "userPhone": { "type": "string", "maxLength": 30 },
        "topic": { "type": "string", "enum": ["general", "technical", "hardware", "sync", "billing"] },
        "priority": { "type": "string", "enum": ["normal", "high", "urgent"] },
        "subject": { "type": "string", "minLength": 3, "maxLength": 160 },
        "description": { "type": "string", "minLength": 10, "maxLength": 2500 },
        "appVersion": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["pending", "in_progress", "resolved", "rejected"] },
        "adminResponse": { "type": "string", "maxLength": 1500 },
        "handledBy": { "type": "string", "maxLength": 120 },
        "handledAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "appId", "topic", "priority", "subject", "description", "status", "createdAt"]
    },
    "DigiSoliaAdministrator": {
      "title": "DigiSoliaAdministrator",
      "description": "Central DigiSolia Admin role assignment with application scope",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["super_admin", "app_admin", "support_agent", "stats_reader"] },
        "assignedApps": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role", "status"]
    },
    "DigiSoliaAuditLog": {
      "title": "DigiSoliaAuditLog",
      "description": "Immutable administrative audit log for DigiSolia Admin operations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 120 },
        "actorRole": { "type": "string", "maxLength": 40 },
        "action": { "type": "string", "maxLength": 100 },
        "targetPath": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "actorUid", "actorEmail", "action", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Item in inventory with barcode and real-time stock levels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "code": { "type": "string", "maxLength": 50 },
        "barcode": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "purchasePrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "unit": { "type": "string", "maxLength": 30 },
        "imageUrl": { "type": "string" },
        "isFavorite": { "type": "boolean" }
      },
      "required": ["id", "businessId", "name", "salePrice", "stock"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Client profile with credit tracking and transaction summary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 200 },
        "creditBalance": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "lastPurchaseDate": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "phone"]
    },
    "SaleTransaction": {
      "title": "SaleTransaction",
      "description": "Completed, refunded or cancelled retail sale transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketNumber": { "type": "string", "maxLength": 50 },
        "businessId": { "type": "string" },
        "cashierId": { "type": "string" },
        "cashierName": { "type": "string", "maxLength": 100 },
        "customerId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountTotal": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "mobile_money", "card", "credit"] },
        "amountReceived": { "type": "number" },
        "changeDue": { "type": "number" },
        "developerFee": { "type": "number" },
        "timestamp": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "refunded", "cancelled"] },
        "cancelledAt": { "type": "string", "maxLength": 40 },
        "cancelledBy": { "type": "string", "maxLength": 100 },
        "cancelledById": { "type": "string", "maxLength": 128 },
        "cancellationReason": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "ticketNumber", "businessId", "cashierId", "totalAmount", "paymentMethod", "timestamp", "status"]
    },
    "CashRegisterSession": {
      "title": "CashRegisterSession",
      "description": "Cash register open and close session for cashiers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "cashierId": { "type": "string" },
        "cashierName": { "type": "string", "maxLength": 100 },
        "openedAt": { "type": "string" },
        "closedAt": { "type": "string" },
        "openingFloat": { "type": "number" },
        "expectedCash": { "type": "number" },
        "actualCash": { "type": "number" },
        "cashDifference": { "type": "number" },
        "totalSalesAmount": { "type": "number" },
        "totalSalesCount": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "businessId", "cashierId", "openedAt", "openingFloat", "status"]
    },
    "PushNotification": {
      "title": "PushNotification",
      "description": "System, DigiSolia ecosystem and business event push notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appId": { "type": "string", "maxLength": 64 },
        "targetRole": { "type": "string", "enum": ["all", "developer", "owner", "manager", "cashier"] },
        "businessId": { "type": "string" },
        "businessName": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["sale_milestone", "low_stock", "subscription", "security", "system", "digisolia_announcement"] },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["normal", "high", "urgent"] }
      },
      "required": ["id", "targetRole", "title", "message", "type", "timestamp", "read"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Audit trail log of stock entry, sale, return or adjustment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["in", "out", "sale", "adjustment"] },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "businessId", "productId", "type", "quantity", "timestamp"]
    }
  },
  "firestore": {
    "/apps/{appId}": {
      "schema": "DigiSoliaApp",
      "description": "Registry of DigiSolia ecosystem applications and global stats"
    },
    "/apps/{appId}/feedback/{feedbackId}": {
      "schema": "DigiSoliaFeedback",
      "description": "Ratings, comments, suggestions, bug reports and complaints per app"
    },
    "/apps/{appId}/support/{ticketId}": {
      "schema": "DigiSoliaSupportTicket",
      "description": "Customer helpdesk and technical support tickets per app"
    },
    "/administrators/{adminId}": {
      "schema": "DigiSoliaAdministrator",
      "description": "Central DigiSolia Admin role assignments and permissions"
    },
    "/admin_audit_logs/{logId}": {
      "schema": "DigiSoliaAuditLog",
      "description": "Immutable log of administrative operations across DigiSolia Admin"
    },
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Registered merchant businesses and subscription records"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "DigiSolia framework user profiles and Caisse Pro staff accounts"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Inventory items and real-time stock balances"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Registered customers and credit ledgers"
    },
    "/transactions/{transactionId}": {
      "schema": "SaleTransaction",
      "description": "Point-of-sale sales logs and receipts"
    },
    "/sessions/{sessionId}": {
      "schema": "CashRegisterSession",
      "description": "Register shift sessions and cash reconciliation"
    },
    "/notifications/{notificationId}": {
      "schema": "PushNotification",
      "description": "System, DigiSolia ecosystem, owner and cashier notifications"
    },
    "/movements/{movementId}": {
      "schema": "StockMovement",
      "description": "Inventory movement and replenishment audit logs"
    }
  }
}
